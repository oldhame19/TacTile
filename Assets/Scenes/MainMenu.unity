--- !u!114 &933
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 930}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.95, b: 0.95, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FFCC33>OBJECTIVE</color></b>\nControl the most tiles when the game ends. Each tile you own is worth 1 point.\n\n<b><color=#FFCC33>TAKE YOUR TURN</color></b>\n\u2022 Select one of your unplaced tiles.\n\u2022 Place it on any empty space.\n\u2022 Players alternate turns. Placed tiles cannot move or rotate.\n\n<b><color=#FFCC33>CAPTURE TILES</color></b>\nCompare touching edges:\n\u2022 Top vs. Bottom\n\u2022 Left vs. Right\nYour tile captures an adjacent opponent's tile only when its effective strength is higher. Ties do not capture. Captures do not chain.\n\n<b><color=#FFCC33>BOOST SPACES</color></b>\n\u2022 <color=#B366FF>Purple</color>: +1 strength to every side.\n\u2022 <color=#FF4D4D>Red</color>, <color=#66CCFF>Light Blue</color>, and <color=#FFDD44>Yellow</color>: +1 strength to every side when the tile's tick color matches.\nBonuses apply to both attacking and defending tiles.\n\n<b><color=#FFCC33>WIN THE GAME</color></b>\nThe game ends when the board is full or both players have no tiles left to place. The player with the most tiles wins. Tied scores result in a draw."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
